{
  "name": "bicos-app",
  "version": "1.0.0",
  "description": "Bicos — marketplace de diárias de obra (implementação do handoff do Claude Design)",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.css --watch",
    "build:js": "esbuild js/main.js --bundle --outfile=js/bundle.js --format=iife",
    "watch:js": "esbuild js/main.js --bundle --outfile=js/bundle.js --format=iife --watch",
    "build": "npm run build:css && npm run build:js",
    "start": "npm run build && npx --yes serve -l 5173 ."
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "lucide-static": "^1.46.0",
    "tailwindcss": "^3.4.19"
  }
}

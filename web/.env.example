# Copie para .env.local (nunca versionado) e preencha. Tudo aqui vai para o navegador: só valores
# PÚBLICOS. Segredos (service_role, tokens do Mercado Pago, Twilio, Turnstile, VAPID privada) ficam em
# Supabase → Edge Functions → Secrets — veja docs/SUPABASE.md.
#
# Sem as duas primeiras o app roda com os dados de demonstração em memória (src/services/mode.ts).

# --- Supabase (Project Settings → API). Só a chave "anon"; a "service_role" nunca vai para o front-end.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Endereço publicado (sem barra no fim), para a prévia do link no WhatsApp (og:image) — X02.
VITE_SITE_URL=
# Pasta onde o app fica no servidor, se não for a raiz (ex.: /app/) — X17. Padrão: /
VITE_BASE=

# --- Funções que dependem de serviço externo: ficam escondidas até serem configuradas (services/features.ts).
# Impulsionar vaga (Mercado Pago): VITE_PAGAMENTOS=mercadopago + a chave PÚBLICA.
VITE_PAGAMENTOS=
VITE_MP_PUBLIC_KEY=
# Captcha no cadastro e no login por documento (Cloudflare Turnstile): a site key PÚBLICA.
VITE_TURNSTILE_SITE_KEY=
# "Continuar com o Google" (ligue o provedor Google no Supabase Auth antes): 1 para mostrar.
VITE_LOGIN_GOOGLE=
# Código por WhatsApp/SMS para confirmar o número (Twilio Verify + Edge Function codigo-whatsapp): 1.
VITE_CODIGO_WHATSAPP=
# Notificações no celular (Web Push): a chave VAPID PÚBLICA (a privada vai nos Secrets).
VITE_VAPID_PUBLIC_KEY=

# --- Suporte e observabilidade
# WhatsApp do suporte (só dígitos, com DDD).
VITE_SUPORTE_WHATSAPP=
# Captura de erros (Sentry), sem dados pessoais — X21. Vazio: nada sai do aparelho.
VITE_SENTRY_DSN=
VITE_RELEASE=

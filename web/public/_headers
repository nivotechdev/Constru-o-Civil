# L08 — Cabeçalhos de segurança do site (Cloudflare Pages lê este arquivo de dist/). A CSP libera só o que o app
# usa: Supabase (dados, Auth, Realtime, fotos), Turnstile, Mercado Pago, Sentry, BrasilAPI/ViaCEP (CEP e CNPJ) e, para
# entrar com Google ou celular (U28), o Firebase Authentication e o reCAPTCHA do Google.
# src/__tests__/headers.test.ts confere que cada endereço externo do código está liberado aqui.
# Câmera: a selfie usa o app de câmera do próprio celular (<input capture>), que não depende desta permissão —
# por isso a página não precisa de acesso direto à câmera em lugar nenhum.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://sdk.mercadopago.com https://http2.mlstatic.com https://apis.google.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co https://*.googleusercontent.com https://*.mlstatic.com; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.sentry.io https://brasilapi.com.br https://viacep.com.br https://nominatim.openstreetmap.org https://photon.komoot.io https://api.mercadopago.com https://*.mercadopago.com https://*.mercadolibre.com https://challenges.cloudflare.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://*.firebaseapp.com; frame-src https://challenges.cloudflare.com https://*.mercadopago.com https://*.mercadopago.com.br https://*.mercadolibre.com https://*.firebaseapp.com https://www.google.com https://recaptcha.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=(), bluetooth=(), serial=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Arquivos com hash no nome nunca mudam: o celular guarda de vez.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# O service worker e o manifesto sempre conferem se há versão nova.
/sw.js
  Cache-Control: no-cache
/push-sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

{
  "name": "bicos-web",
  "version": "2.0.0",
  "description": "Bicos — marketplace de diárias de obra (front-end em React + TypeScript)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "build:staging": "tsc -b && vite build --mode staging",
    "deploy:staging": "bash scripts/deploy.sh staging",
    "deploy:producao": "bash scripts/deploy.sh producao",
    "build:standalone": "tsc -b && vite build --mode standalone",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "parity": "node scripts/parity/run.mjs",
    "gen:types": "node scripts/gen-db-types.mjs"
  },
  "dependencies": {
    "@firebase/app": "0.16.3",
    "@firebase/auth": "1.13.7",
    "@fontsource/barlow": "^5.2.6",
    "@fontsource/plus-jakarta-sans": "^5.2.6",
    "@fontsource/space-mono": "^5.2.8",
    "@supabase/supabase-js": "^2.117.2",
    "heic2any": "^0.0.4",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "pixelmatch": "^7.1.0",
    "playwright": "1.56.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.0.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4"
  }
}

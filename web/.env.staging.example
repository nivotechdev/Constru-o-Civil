# L02 — Variáveis do build de STAGING. Copie para .env.staging.local (nunca versionado) e rode
# `npm run build:staging` (modo "staging": confere as mesmas obrigatórias da produção — L01).
# Só valores PÚBLICOS; segredos ficam em Edge Functions › Secrets do projeto de staging.

# [obrigatória] Projeto bicos-staging (Project Settings › API)
VITE_SUPABASE_URL=https://<ref-do-staging>.supabase.co
# [obrigatória]
VITE_SUPABASE_ANON_KEY=
# [obrigatória] Endereço do staging no Cloudflare Pages
VITE_SITE_URL=https://staging.bicos-app.pages.dev
# [obrigatória] Turnstile: a chave de TESTE da Cloudflare passa sempre (não use em produção)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# [obrigatória] Projeto Sentry de staging (ou o mesmo, com environment=staging)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=staging

VITE_SUPORTE_WHATSAPP=
VITE_LOGIN_GOOGLE=
VITE_CODIGO_WHATSAPP=
VITE_PAGAMENTOS=
VITE_MP_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
